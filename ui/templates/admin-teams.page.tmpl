{{template "base" .}}

{{define "title"}}Admin Teams{{end}}

{{define "main"}}
<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; margin-bottom: 2rem;">
    <div>
        <h2>Team Onboarding</h2>
        <p style="color: var(--text-secondary);">Create a login and place it onto a team.</p>
    </div>
</div>

<div class="grid">
    <div class="card">
        <h3>Onboard Member</h3>
        <form action="/admin/teams" method="POST" style="margin-top:1rem; display:flex; flex-direction:column; gap:1rem;">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="{{with .Form}}{{.Email}}{{end}}" placeholder="new.member@example.com">
            </div>
            <div class="form-group">
                <label>Temporary Password</label>
                <input type="password" name="password" placeholder="At least 8 characters">
            </div>
            <div class="form-group">
                <label>Team</label>
                <select name="team_id">
                    <option value="">Select a team</option>
                    {{range .Teams}}
                    <option value="{{.ID}}">{{.Name}}</option>
                    {{end}}
                </select>
            </div>
            <div class="form-group">
                <label>Role</label>
                <select name="role">
                    <option value="member" {{with .Form}}{{if eq .Role "member"}}selected{{end}}{{end}}>Member</option>
                    <option value="reviewer" {{with .Form}}{{if eq .Role "reviewer"}}selected{{end}}{{end}}>Reviewer</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Create Account</button>
        </form>
    </div>

    <div class="card">
        <h3>Available Teams</h3>
        {{if .Teams}}
        <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
            {{range .Teams}}
            <div style="display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1rem; border:1px solid var(--border-color); border-radius:14px;">
                <strong>{{.Name}}</strong>
                <span class="badge badge-blue mono">#{{.ID}}</span>
            </div>
            {{end}}
        </div>
        {{else}}
        <p style="color: var(--text-secondary); margin-top: 1rem;">No teams configured yet.</p>
        {{end}}
    </div>
</div>

{{end}}