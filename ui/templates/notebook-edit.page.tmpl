{{template "base" .}}

{{define "title"}}Edit Draft{{end}}

{{define "main"}}
<div style="max-width: 800px; margin: 0 auto;">
    <h2 style="margin-bottom: 1.5rem;">Edit Draft Revision</h2>

    <div class="card">
        <form action="/notebooks/{{.CurrentRevision.NotebookID}}/edit" method="POST" novalidate>
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

            <div class="form-group">
                <label>Title</label>
                <input type="text" name="title" value="{{.Form.Title}}">
                {{with .Errors.title}}
                    <span class="error">{{.}}</span>
                {{end}}
            </div>

            <div class="form-group">
                <label>Tags</label>
                <input type="text" name="tags" value="{{.Form.Tags}}" placeholder="incident, database, on-call">
            </div>

            <div class="form-group">
                <label>Content (Markdown)</label>
                <textarea name="body" rows="12">{{.Form.Body}}</textarea>
                {{with .Errors.body}}
                    <span class="error">{{.}}</span>
                {{end}}
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/notebooks/{{.CurrentRevision.NotebookID}}" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
{{end}}
